  */

  {
  "name": "timecounterpro",
  "compatibility_date": "2024-08-24",
  "assets": {
    "directory": "./dist",
    // Every route is prerendered to its own .html file, so unknown URLs get a
    // real 404 (dist/404.html) instead of the home page.
    "not_found_handling": "404-page"
  }
}
